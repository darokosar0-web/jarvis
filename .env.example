# Copy this file to .env and fill in your API keys
# In Netlify: add these under Site Settings > Environment Variables

# Required: Password for Jarvis login page
JARVIS_PASSWORD=your_secure_password_here

# Required: Claude API key for Jarvis advisor
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Brave Search API key for web search capabilities
# Get a free API key at https://api.search.brave.com/app/keys
BRAVE_API_KEY=your_brave_search_api_key_here

# Optional: ElevenLabs API key for high-quality text-to-speech
# Get a free API key at https://elevenlabs.io/sign-up
# Falls back to browser TTS if not configured
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Upstash Redis for persistent memory and to-do lists
# Get free credentials at https://upstash.com
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Optional: Gmail integration for reading and sending emails
# Create OAuth credentials at https://console.cloud.google.com
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_CALLBACK_URL=https://your-vercel-domain.vercel.app/api/gmail-callback
